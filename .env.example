# MongoDB Atlas 연결 문자열 (DB 이름까지 포함)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todo

# GitHub OAuth App (https://github.com/settings/developers → New OAuth App)
# Homepage URL:            http://localhost:3000
# Authorization callback URL (Redirect URI): http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 배포 환경에서 콜백 URL을 올바르게 만들기 위한 기준 주소 (로컬은 비워두면 자동으로 요청 origin 사용)
# NEXT_PUBLIC_BASE_URL=https://your-deployed-domain.com
